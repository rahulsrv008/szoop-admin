# Backend the admin panel talks to (clearit-be on Vercel).
# API_URL=https://clearit-be.vercel.app/api/v1
# Local backend instead:
API_URL=http://localhost:3000/api/v1

# `npm start` only: route API calls through the dev server so any localhost
# port works without the backend allowing it in CORS. Set to false to call
# API_URL directly from the browser.
DEV_PROXY=true

# Browser API key for the admin dashboard's Google Map.
# Restrict it in Google Cloud to the Maps JavaScript API and your admin site origins.
# GOOGLE_MAPS_API_KEY=AIzaSyA8tsdM2um9X_GIFyE2mvFQxkbm0s-4YNY
GOOGLE_MAPS_API_KEY=AIzaSyDtIWn9TJ19MinO4VFBdZpNTSCYQnq9Bo4